{
  "name": "english-remote-it",
  "version": "1.2.0",
  "private": true,
  "description": "English for Remote IT & Freelancer — 60 ngày (PWA + Android app)",
  "scripts": {
    "serve": "npx --yes http-server . -p 8080 -c-1",
    "build:www": "node scripts/build-www.js",
    "sync": "npm run build:www && npx cap sync android",
    "apk": "npm run sync && cd android && gradlew.bat assembleDebug"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "lucide-static": "^0.577.0",
    "puppeteer-core": "^23.11.1"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.2",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/share": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3"
  }
}
